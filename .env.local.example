# Supabase 프로젝트 설정 (Settings > API)
# 미설정 시 앱은 게스트 모드(localStorage)로만 동작한다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 배포 도메인 (공유 링크 생성 시 사용, 미설정 시 window.location.origin 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 모바일 ngrok 테스트 시 본인 ngrok 호스트 (예: abc123.ngrok-free.app)
# next.config.ts allowedDevOrigins에 추가됩니다. 설정 후 dev 서버 재시작 필수.
MOBILE_DEV_HOST=
